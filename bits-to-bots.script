# 1. Fondo gris oscuro personalizado para que combine bien con tu logo
Window.SetBackgroundTopColor(0.12, 0.12, 0.12);
Window.SetBackgroundBottomColor(0.12, 0.12, 0.12);

# 2. Cargar el logotipo de Bits a Bots
logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);

# 3. Centrar el logotipo en cualquier pantalla de forma automática
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

logo_width = logo_image.GetWidth();
logo_height = logo_image.GetHeight();

logo_x = (screen_width / 2) - (logo_width / 2);
logo_y = (screen_height / 2) - (logo_height / 2);

logo_sprite.SetX(logo_x);
logo_sprite.SetY(logo_y);

# 4. Configurar variables para la animación de parpadeo suave
progress = 0;

fun refresh_callback () {
    # Incrementamos el progreso para calcular el ciclo de la animación
    global.progress += 0.04;
    wave1 = Math.Sin(global.progress);
    wave2 = Math.Sin(global.progress * 2);
    # Usamos la función matemática Seno para crear una onda suave de opacidad
    # Esto genera un valor que fluctúa suavemente entre 0.3 y 1.0 (brillo)
    opacity = ((wavw1 + wave2) / 2) * 0.35 + 0.65;
    
    # Aplicamos la opacidad calculada al logotipo en este fotograma
    global.logo_sprite.SetOpacity(opacity);
}

Plymouth.SetRefreshFunction(refresh_callback);
